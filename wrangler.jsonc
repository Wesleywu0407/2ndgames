{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyveil",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static game files. `none` makes a miss return a real 404 instead of an SPA
  // fallback, so the worker's R2 route and API 404s behave predictably.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skyveil-world",
      "database_id": "PLACEHOLDER_REPLACED_BY_WRANGLER_D1_CREATE",
      "migrations_dir": "drizzle"
    }
  ],

  // Assets over Cloudflare's 25 MiB per-file static limit are served from here.
  "r2_buckets": [
    {
      "binding": "LARGE_ASSETS",
      "bucket_name": "skyveil-large-assets"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "WORLD_ROOM", "class_name": "WorldRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["WorldRoom"] }]
}
